+++ b/.github/workflows/deploy-worker.yml
@@ -0,0 +1,52 @@
+name: Deploy to Cloudflare Worker
+
+# Builds the site and deploys it with the Worker in worker/ (live RingCentral API).
+# Needs two repository secrets: CLOUDFLARE_API_TOKEN (a token with "Workers Scripts: Edit")
+# and CLOUDFLARE_ACCOUNT_ID. Until both exist this workflow skips the deploy instead of failing.
+# The Worker's own secrets (RC_CREDENTIALS_JSON, DASHBOARD_PASSWORD) are set once on the
+# Worker itself — see README — not here.
+
+on:
+  push:
+    branches:
+      - main
+      - claude/stoic-ptolemy-kjd4q5
+  workflow_dispatch:
+
+permissions:
+  contents: read
+
+concurrency:
+  group: cloudflare-worker
+  cancel-in-progress: true
+
+jobs:
+  deploy:
+    runs-on: ubuntu-latest
+    env:
+      CLOUDFLARE_API_TOKEN: ${{ secrets.CLOUDFLARE_API_TOKEN }}
+      CLOUDFLARE_ACCOUNT_ID: ${{ secrets.CLOUDFLARE_ACCOUNT_ID }}
+    steps:
+      - name: Check for Cloudflare credentials
+        id: creds
+        run: |
+          if [ -z "$CLOUDFLARE_API_TOKEN" ] || [ -z "$CLOUDFLARE_ACCOUNT_ID" ]; then
+            echo "::notice::CLOUDFLARE_API_TOKEN / CLOUDFLARE_ACCOUNT_ID secrets not set; skipping the Worker deploy."
+            echo "present=false" >> "$GITHUB_OUTPUT"
+          else
+            echo "present=true" >> "$GITHUB_OUTPUT"
+          fi
+      - uses: actions/checkout@v4
+        if: steps.creds.outputs.present == 'true'
+      - uses: actions/setup-node@v4
+        if: steps.creds.outputs.present == 'true'
+        with:
+          node-version: 22
+          cache: npm
+      - if: steps.creds.outputs.present == 'true'
+        run: npm ci
+      - if: steps.creds.outputs.present == 'true'
+        run: npm test
+      - name: Build and deploy
+        if: steps.creds.outputs.present == 'true'
+        run: npm run deploy
